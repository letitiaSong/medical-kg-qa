# ===== TuGraph 连接 =====
# 复制本文件为 .env 后按自己的环境修改；.env 不要提交到 GitHub
TUGRAPH_HOST=127.0.0.1
TUGRAPH_PORT=7070
TUGRAPH_USER=admin
TUGRAPH_PASSWORD=<本机 TuGraph 密码>
TUGRAPH_GRAPH=medical_course_2026
# auto：先试真库，连不上自动用离线模拟库；rest：只连真库；mock：只用离线库
TUGRAPH_MODE=auto

# ===== 大模型（Qwen，OpenAI 兼容接口）=====
# 不填 Key 时自动使用离线规则模型（--llm fake），照样能演示完整流程
DASHSCOPE_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
# auto：有 Key 就调 API；real：必须有 Key；fake：只用离线规则
LLM_MODE=auto